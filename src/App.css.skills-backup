@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500&display=swap');

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #dcecf5;
  color: #17242b;
  font-family: 'DM Sans', sans-serif;
}

button {
  font: inherit;
}

.portfolio-home {
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

.sky {
  position: relative;
  min-height: 100vh;
  width: 100%;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 18%,
      rgba(255, 244, 201, 0.9),
      transparent 18%
    ),
    linear-gradient(
      180deg,
      #b9dceb 0%,
      #d8edf4 48%,
      #f4eee1 100%
    );
}

/* SUN */

.sun {
  position: absolute;
  width: 190px;
  height: 190px;
  right: 9%;
  top: 7%;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255, 250, 225, 0.95) 0%,
      rgba(255, 241, 190, 0.55) 45%,
      rgba(255, 241, 190, 0) 72%
    );

  filter: blur(1px);
}

/* INTRO */

.intro {
  position: absolute;
  z-index: 10;

  top: 50%;
  left: 50%;

  width: min(650px, 80vw);

  transform: translate(-50%, -50%);

  text-align: center;

  pointer-events: none;

  transition:
    opacity 0.8s ease,
    transform 0.8s ease;
}

.eyebrow {
  margin: 0 0 18px;

  font-size: 11px;
  letter-spacing: 0.28em;
  font-weight: 500;

  opacity: 0.7;
}

.intro h1 {
  margin: 0;

  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(64px, 9vw, 130px);
  line-height: 0.8;
  font-weight: 500;
  letter-spacing: -0.04em;
}

.intro-text {
  max-width: 460px;
  margin: 30px auto 0;

  font-size: 15px;
  line-height: 1.7;
  font-weight: 300;

  opacity: 0.75;
}

.instruction {
  margin-top: 34px;

  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.22em;

  opacity: 0.5;
}

/* PLANE */

.plane {
  position: absolute;
  z-index: 20;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  opacity: 0;

  transition:
    opacity 1s ease 0.8s,
    transform 1.8s cubic-bezier(0.2, 0.8, 0.2, 1);

  pointer-events: none;
}

.loaded .plane {
  opacity: 1;
}

.plane-body {
  position: relative;

  font-size: 58px;

  transform: rotate(-8deg);

  filter:
    drop-shadow(0 8px 12px rgba(43, 63, 72, 0.18));
}

.plane-trail {
  position: absolute;

  width: 160px;
  height: 1px;

  right: 42px;
  top: 39px;

  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.75)
  );
}

/* CLOUD FIELD */

.cloud-field {
  position: absolute;
  inset: 0;

  z-index: 15;

  pointer-events: none;
}

/* CLOUD */

.cloud {
  position: absolute;

  width: 170px;
  height: 95px;

  border: 0;
  padding: 0;

  background: transparent;

  cursor: pointer;

  opacity: 0;

  pointer-events: auto;

  transition:
    transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1),
    opacity 1s ease,
    filter 0.4s ease;
}

.loaded .cloud {
  opacity: 1;
}

.cloud:hover {
  filter: brightness(1.04);
}

.cloud.selected {
  filter:
    drop-shadow(0 12px 18px rgba(80, 105, 115, 0.2));
}

/* CLOUD SHAPE */

.cloud-shape {
  position: absolute;

  inset: 10px 0 15px;

  display: block;

  background: rgba(255, 255, 255, 0.78);

  border-radius: 70px;

  box-shadow:
    0 12px 35px rgba(80, 110, 125, 0.08);
}

.cloud-shape span {
  position: absolute;

  display: block;

  background: rgba(255, 255, 255, 0.82);

  border-radius: 50%;
}

.cloud-shape span:nth-child(1) {
  width: 72px;
  height: 72px;

  left: 28px;
  top: -32px;
}

.cloud-shape span:nth-child(2) {
  width: 58px;
  height: 58px;

  left: 72px;
  top: -22px;
}

.cloud-shape span:nth-child(3) {
  width: 48px;
  height: 48px;

  right: 20px;
  top: -12px;
}

.cloud-label {
  position: absolute;

  left: 50%;
  top: 48%;

  transform: translate(-50%, -50%);

  color: #263940;

  font-size: 10px;
  font-weight: 500;

  text-transform: uppercase;
  letter-spacing: 0.18em;

  white-space: nowrap;
}

/* INITIAL CLOUD POSITIONS
   They begin near the centre,
   then scatter outward.
*/

.cloud-about {
  left: 50%;
  top: 39%;

  transform: translate(-50%, -50%);
}

.cloud-work {
  left: 50%;
  top: 47%;

  transform: translate(-50%, -50%);
}

.cloud-skills {
  left: 50%;
  top: 55%;

  transform: translate(-50%, -50%);
}

.cloud-experience {
  left: 50%;
  top: 43%;

  transform: translate(-50%, -50%);
}

.cloud-learning {
  left: 50%;
  top: 51%;

  transform: translate(-50%, -50%);
}

.cloud-contact {
  left: 50%;
  top: 59%;

  transform: translate(-50%, -50%);
}

/* SCATTERED POSITIONS */

.loaded .cloud-about {
  transform:
    translate(
      calc(-50% - 32vw),
      calc(-50% - 22vh)
    );
}

.loaded .cloud-work {
  transform:
    translate(
      calc(-50% + 28vw),
      calc(-50% - 25vh)
    );
}

.loaded .cloud-skills {
  transform:
    translate(
      calc(-50% - 38vw),
      calc(-50% + 18vh)
    );
}

.loaded .cloud-experience {
  transform:
    translate(
      calc(-50% + 37vw),
      calc(-50% + 10vh)
    );
}

.loaded .cloud-learning {
  transform:
    translate(
      calc(-50% - 25vw),
      calc(-50% + 34vh)
    );
}

.loaded .cloud-contact {
  transform:
    translate(
      calc(-50% + 27vw),
      calc(-50% + 33vh)
    );
}

/* DESTINATION MESSAGE */

.destination-message {
  position: absolute;

  z-index: 30;

  left: 50%;
  bottom: 9%;

  transform: translateX(-50%);

  padding: 12px 20px;

  border: 1px solid rgba(40, 60, 68, 0.12);

  background: rgba(255, 255, 255, 0.35);

  backdrop-filter: blur(12px);

  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  animation: appear 0.5s ease forwards;
}

.destination-message span {
  margin-left: 12px;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translate(-50%, 10px);
  }

  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* BOTTOM MARK */

.bottom-mark {
  position: absolute;

  z-index: 30;

  left: 35px;
  bottom: 28px;

  display: flex;
  gap: 18px;

  font-size: 9px;
  letter-spacing: 0.2em;

  opacity: 0.5;
}

/* RESPONSIVE */

@media (max-width: 700px) {

  .sun {
    width: 130px;
    height: 130px;

    right: -20px;
    top: 8%;
  }

  .intro {
    width: 88vw;
  }

  .intro h1 {
    font-size: clamp(55px, 17vw, 90px);
  }

  .intro-text {
    font-size: 14px;
  }

  .cloud {
    width: 125px;
    height: 75px;
  }

  .cloud-label {
    font-size: 8px;
  }

  .loaded .cloud-about {
    transform:
      translate(
        calc(-50% - 24vw),
        calc(-50% - 27vh)
      );
  }

  .loaded .cloud-work {
    transform:
      translate(
        calc(-50% + 25vw),
        calc(-50% - 28vh)
      );
  }

  .loaded .cloud-skills {
    transform:
      translate(
        calc(-50% - 29vw),
        calc(-50% + 20vh)
      );
  }

  .loaded .cloud-experience {
    transform:
      translate(
        calc(-50% + 29vw),
        calc(-50% + 18vh)
      );
  }

  .loaded .cloud-learning {
    transform:
      translate(
        calc(-50% - 22vw),
        calc(-50% + 35vh)
      );
  }

  .loaded .cloud-contact {
    transform:
      translate(
        calc(-50% + 23vw),
        calc(-50% + 36vh)
      );
  }

  .plane-body {
    font-size: 45px;
  }
}
/* =========================================
   INTERNAL NIGHT-SKY PAGES
   ========================================= */

.inner-page {
  min-height: 100vh;
  margin: 0;
  color: #f3f0e8;
  background: #07111f;
}

.night-sky {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 18%, rgba(112, 139, 168, 0.18), transparent 24%),
    radial-gradient(circle at 18% 82%, rgba(67, 92, 122, 0.14), transparent 28%),
    linear-gradient(145deg, #081321 0%, #0b1728 48%, #111d2d 100%);
}

/* Stars */

.stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.star {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: var(--size);
  height: var(--size);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.25);
  animation: twinkle 4s ease-in-out infinite;
  animation-delay: var(--delay);
}

@keyframes twinkle {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.8);
  }

  50% {
    opacity: 0.9;
    transform: scale(1.2);
  }
}

/* Moon */

.moon {
  position: absolute;
  top: 105px;
  right: 9%;
  width: 150px;
  height: 150px;
}

.moon-glow {
  position: absolute;
  inset: -45px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(232, 228, 205, 0.18),
    rgba(232, 228, 205, 0.05) 45%,
    transparent 70%
  );
}

.moon-disc {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 30%, #f8f5e9 0%, #ddd9c8 55%, #aaa997 100%);
  box-shadow:
    0 0 40px rgba(230, 225, 205, 0.22),
    0 0 90px rgba(230, 225, 205, 0.1);
}

/* Navigation */

.inner-nav {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(1240px, calc(100% - 80px));
  margin: 0 auto;
  padding: 32px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.inner-nav nav {
  display: flex;
  align-items: center;
  gap: 34px;
}

.home-mark {
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: transparent;
  color: #f3f0e8;
  font-family: "DM Sans", sans-serif;
  font-size: 11px;
  letter-spacing: 0.16em;
  cursor: pointer;
  transition: all 0.3s ease;
}

.home-mark:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.7);
}

.nav-link {
  position: relative;
  color: rgba(243, 240, 232, 0.58);
  text-decoration: none;
  font-family: "DM Sans", sans-serif;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: color 0.3s ease;
}

.nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -9px;
  height: 1px;
  background: #f3f0e8;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.3s ease;
}

.nav-link:hover {
  color: #ffffff;
}

.nav-link.active {
  color: #ffffff;
}

.nav-link.active::after {
  transform: scaleX(1);
}

.nav-year {
  color: rgba(243, 240, 232, 0.45);
  font-family: "DM Sans", sans-serif;
  font-size: 10px;
  letter-spacing: 0.18em;
}

/* Main content */

.inner-content {
  position: relative;
  z-index: 5;
  width: min(1240px, calc(100% - 80px));
  margin: 0 auto;
  padding: 110px 0 120px;
}

.inner-eyebrow {
  margin: 0 0 22px;
  color: rgba(243, 240, 232, 0.55);
  font-family: "DM Sans", sans-serif;
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

.inner-content h1 {
  max-width: 850px;
  margin: 0;
  color: #f5f1e8;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(64px, 8vw, 120px);
  font-weight: 400;
  line-height: 0.88;
  letter-spacing: -0.035em;
}

.content-line {
  width: 100%;
  height: 1px;
  margin: 55px 0 55px;
  background: rgba(255, 255, 255, 0.14);
}

.page-content {
  max-width: 1100px;
}

.lead {
  max-width: 760px;
  margin: 0 0 55px;
  color: rgba(243, 240, 232, 0.82);
  font-family: "DM Sans", sans-serif;
  font-size: 20px;
  line-height: 1.7;
}

/* Project cards */

.project-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.project-card {
  position: relative;
  min-height: 390px;
  padding: 30px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  text-align: left;
  border: 1px solid rgba(244, 240, 232, 0.14);
  background: rgba(255, 255, 255, 0.035);
  color: #f4f0e8;
  cursor: pointer;
  transition:
    transform 0.35s ease,
    background 0.35s ease,
    border-color 0.35s ease;
}

.project-card:hover {
  transform: translateY(-8px);
  background: rgba(255, 255, 255, 0.075);
  border-color: rgba(244, 240, 232, 0.32);
}

.project-card .project-number {
  flex-shrink: 0;
  margin: 0 0 34px;
  font-family: "DM Sans", sans-serif;
  font-size: 11px;
  letter-spacing: 0.15em;
  color: rgba(244, 240, 232, 0.45);
}

.project-content {
  position: static;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.project-card .project-category {
  margin: 0 0 14px;
  font-family: "DM Sans", sans-serif;
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: 0.13em;
  color: rgba(244, 240, 232, 0.5);
}

.project-card h2 {
  margin: 0 0 18px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(38px, 4vw, 58px);
  font-weight: 400;
  line-height: 0.95;
  color: #f4f0e8;
}

.project-card .project-description {
  margin: 0;
  max-width: 100%;
  font-family: "DM Sans", sans-serif;
  font-size: 13px;
  line-height: 1.7;
  color: rgba(244, 240, 232, 0.62);
}

.project-footer {
  margin-top: auto;
  padding-top: 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(244, 240, 232, 0.12);
  font-family: "DM Sans", sans-serif;
  font-size: 10px;
  letter-spacing: 0.12em;
  color: rgba(244, 240, 232, 0.65);
}

.project-arrow {
  font-size: 18px;
  letter-spacing: 0;
  transition: transform 0.3s ease;
}

.project-card:hover .project-arrow {
  transform: translate(4px, -4px);
}

@media (max-width: 900px) {
  .project-grid {
    grid-template-columns: 1fr;
  }

  .project-card {
    min-height: 330px;
  }
}

@media (max-width: 600px) {
  .page {
    padding: 90px 24px 60px;
  }

  .work-hero {
    margin-bottom: 45px;
  }

  .project-card {
    min-height: 300px;
    padding: 24px;
  }
}

/* =====================================================
   GOOD MAIDEN CASE STUDY
   ===================================================== */

.case-study-page {
  position: relative;
  z-index: 2;
}

.case-study-page .inner-content {
  position: relative;
  z-index: 5;
}

.case-study-page .inner-nav {
  position: relative;
  z-index: 20;
}

.case-study-page .moon {
  z-index: 1;
}

.case-study-page .case-hero {
  padding: 20px 0 90px;
}

.case-study-page .case-subtitle {
  max-width: 850px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 28px;
  line-height: 1.35;
  margin: 0 0 55px;
  color: rgba(245, 241, 232, 0.9);
}

.case-study-page .case-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  border-top: 1px solid rgba(245, 241, 232, 0.18);
  border-bottom: 1px solid rgba(245, 241, 232, 0.18);
  padding: 28px 0;
}

.case-study-page .case-meta > div {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.case-study-page .case-meta span {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: rgba(245, 241, 232, 0.5);
}

.case-study-page .case-meta strong {
  font-size: 14px;
  line-height: 1.5;
  font-weight: 400;
  color: rgba(245, 241, 232, 0.9);
}

.case-study-page .case-section {
  padding: 90px 0;
  border-top: 1px solid rgba(245, 241, 232, 0.12);
}

.case-study-page .section-number {
  margin: 0 0 20px;
  font-size: 11px;
  letter-spacing: 0.2em;
  color: rgba(245, 241, 232, 0.45);
}

.case-study-page .case-section h2 {
  max-width: 800px;
  margin: 0 0 28px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 52px;
  line-height: 1;
  font-weight: 400;
  color: #f5f1e8;
}

.case-study-page .case-section > p:not(.section-number):not(.case-note) {
  max-width: 900px;
  font-size: 16px;
  line-height: 1.8;
  color: rgba(245, 241, 232, 0.72);
  margin-bottom: 24px;
}

.case-study-page .case-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  margin-top: 45px;
  border-top: 1px solid rgba(245, 241, 232, 0.12);
}

.case-study-page .case-list div {
  padding: 18px 0;
  border-bottom: 1px solid rgba(245, 241, 232, 0.12);
  font-size: 14px;
  color: rgba(245, 241, 232, 0.78);
}

.case-study-page .process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 50px;
}

.case-study-page .process-grid > div {
  min-height: 210px;
  padding: 25px;
  border: 1px solid rgba(245, 241, 232, 0.14);
  background: rgba(255, 255, 255, 0.025);
}

.case-study-page .process-grid span {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: rgba(245, 241, 232, 0.45);
}

.case-study-page .process-grid h3 {
  margin: 55px 0 15px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 28px;
  font-weight: 400;
  color: #f5f1e8;
}

.case-study-page .process-grid p {
  font-size: 13px;
  line-height: 1.65;
  color: rgba(245, 241, 232, 0.6);
}

.case-study-page .tech-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 40px;
}

.case-study-page .tech-row span {
  padding: 10px 15px;
  border: 1px solid rgba(245, 241, 232, 0.2);
  font-size: 10px;
  letter-spacing: 0.15em;
  color: rgba(245, 241, 232, 0.7);
}

.case-study-page .case-note {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 24px !important;
  color: rgba(245, 241, 232, 0.85) !important;
  margin-top: 35px;
}

.case-study-page .return-button {
  margin: 20px 0 100px;
  padding: 13px 20px;
  background: transparent;
  border: 1px solid rgba(245, 241, 232, 0.25);
  color: rgba(245, 241, 232, 0.75);
  font-size: 11px;
  letter-spacing: 0.1em;
  cursor: pointer;
}

.case-study-page .return-button:hover {
  border-color: rgba(245, 241, 232, 0.6);
  color: #f5f1e8;
}


/* MOBILE */

@media (max-width: 800px) {

  .case-study-page .case-meta {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .case-study-page .case-subtitle {
    font-size: 23px;
  }

  .case-study-page .case-section {
    padding: 65px 0;
  }

  .case-study-page .case-section h2 {
    font-size: 40px;
  }

  .case-study-page .case-list {
    grid-template-columns: 1fr;
  }

  .case-study-page .process-grid {
    grid-template-columns: 1fr;
  }

}
/* =====================================================
   FIX: GOOD MAIDEN INNER NAVIGATION
   ===================================================== */

.case-study-page .night-sky {
  position: relative;
  min-height: 100vh;
}

.case-study-page .inner-nav {
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
  position: relative !important;
  z-index: 100 !important;
}

.case-study-page .inner-nav nav {
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
}

.case-study-page .nav-link,
.case-study-page .home-mark,
.case-study-page .nav-year {
  visibility: visible !important;
